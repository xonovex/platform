digraph Kata {
  rankdir=TB;
  splines=false;
  nodesep=0.3;
  ranksep=0.5;
  margin=0.3;

  node [shape=box, style="rounded,filled", fontsize=12, width=3, height=0.5];
  edge [fontsize=9, penwidth=1.5, arrowsize=0.7];

  label="Kata Containers — Lightweight VM Isolation";
  labelloc=t;
  fontsize=14;

  agent [label="AI Agent", role="actor"];
  guest [label="Guest Kernel (separate from the host kernel)"];
  sb [label="sandbox (VM boundary)", role="risk", style="rounded,filled,dashed", fontsize=10];
  vmm [label="Virtual machine monitor (QEMU, cloud-hypervisor)"];
  kvm [label="KVM"];
  kernel [label="Host Kernel", role="strong"];
  hw [label="Hardware (VT-x / AMD-V)", role="panel"];
  pod [label="Pod runtimeClass kata (needs /dev/kvm on the node)\ncounts for RequireKernelIsolation once the AgentPolicy approves it", role="note", fontsize=10];

  agent -> guest [label="  syscalls (guest only)"];
  guest -> sb [label="  virtio devices"];
  sb -> vmm [role="risk", style=dashed];
  vmm -> kvm;
  kvm -> kernel;
  kernel -> hw;

  { rank=same; guest; pod; }
  guest -> pod [style=invis];
}
