digraph GVisor {
  rankdir=TB;
  splines=false;
  nodesep=0.3;
  ranksep=0.5;
  margin=0.3;

  node [shape=box, style="rounded,filled", fontsize=12, width=3, height=0.5];
  edge [fontsize=9, penwidth=1.5, arrowsize=0.7];

  label="gVisor (runsc) — User-Space Kernel";
  labelloc=t;
  fontsize=14;

  agent [label="AI Agent", role="actor"];
  sentry [label="Sentry (user-space kernel)"];

  subgraph {
    rank=same;
    gofer [label="Gofer\n(file proxy, 9P)", width=1.4];
    netstack [label="Netstack\n(user-space TCP/IP)", width=1.4];
  }

  sb [label="sandbox boundary", role="risk", style="rounded,filled,dashed", fontsize=10];
  kernel [label="Host Kernel (~60 syscalls)", role="strong"];
  hw [label="Hardware", role="panel"];

  agent -> sentry [label="  syscalls (intercepted)"];
  sentry -> gofer;
  sentry -> netstack;
  gofer -> sb [label="  file I/O"];
  netstack -> sb [style=invis];
  sb -> kernel [role="risk", style=dashed, label="  minimal surface"];
  kernel -> hw;
}
