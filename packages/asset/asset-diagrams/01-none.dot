digraph None {
  rankdir=TB;
  splines=false;
  nodesep=0.3;
  ranksep=0.5;
  margin=0.3;

  node [shape=box, style="rounded,filled", fontsize=12, width=3, height=0.5];
  edge [fontsize=9, penwidth=1.5, arrowsize=0.7];

  label="None — Direct Execution";
  labelloc=t;
  fontsize=14;

  agent [label="AI Agent", role="actor"];
  prompts [label="Keeps its own permission prompts (Bounded = false)", fontsize=10];
  kernel [label="Host Kernel", role="strong"];
  hw [label="Hardware", role="panel"];

  agent -> prompts;
  prompts -> kernel [label="  all syscalls (unrestricted)"];
  kernel -> hw;

  note [label="No isolation boundary — full host access, host tools stay on PATH", role="risk", style="rounded,filled,dashed", fontsize=10];
  refused [label="Network none and managed are refused: no boundary can enforce them", role="note", fontsize=10];
  hw -> note [style=invis];
  note -> refused [style=invis];
}
