digraph CoCo {
  rankdir=TB;
  splines=false;
  nodesep=0.3;
  ranksep=0.5;
  margin=0.3;

  node [shape=box, style="rounded,filled", fontsize=12, width=3, height=0.5];
  edge [fontsize=9, penwidth=1.5, arrowsize=0.7];

  label="Confidential Containers — TEE Isolation";
  labelloc=t;
  fontsize=14;

  agent [label="AI Agent (encrypted memory)", role="actor"];
  guest [label="Attested Guest Kernel (measured)"];
  sb [label="sandbox (TEE boundary)", role="risk", style="rounded,filled,dashed", fontsize=10];
  vmm [label="Hypervisor (cannot read TEE memory)"];
  kernel [label="Host Kernel (cannot read TEE memory)", role="strong"];
  hw [label="CPU + Memory Encryption HW\n(Intel TDX / AMD SEV-SNP)", role="panel"];
  pod [label="Operator side: runtimeClassName kata-cc or kata-tdx + nodeSelector for TEE nodes.\nThe CoCo stack of the cluster supplies the TEE and the attestation;\nthe e2e tests simulate the classes with runc and exercise no TEE.", role="note", fontsize=10];

  agent -> guest [label="  syscalls"];
  guest -> sb [label="  encrypted VM"];
  sb -> vmm [role="risk", style=dashed];
  vmm -> kernel [label="  KVM (limited)"];
  kernel -> hw [label="  remote attestation\n  (root of trust)"];
  hw -> pod [style=invis];
}
