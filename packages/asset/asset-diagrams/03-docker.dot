digraph Docker {
  rankdir=TB;
  splines=false;
  nodesep=0.3;
  ranksep=0.5;
  margin=0.3;

  node [shape=box, style="rounded,filled", fontsize=12, width=3, height=0.5];
  edge [fontsize=9, penwidth=1.5, arrowsize=0.7];

  label="Docker — Container Isolation";
  labelloc=t;
  fontsize=14;

  agent [label="AI Agent", role="actor"];
  ns [label="All 6 namespaces (PID, Mount, UTS, IPC, Net, User)", fontsize=10];
  cgroups [label="cgroups (CPU, memory, I/O limits)"];
  seccomp [label="seccomp (syscall filter)"];
  sb [label="sandbox boundary", role="risk", style="rounded,filled,dashed", fontsize=10];
  kernel [label="Host Kernel (shared)", role="strong"];
  hw [label="Hardware", role="panel"];

  agent -> ns;
  ns -> cgroups;
  cgroups -> seccomp;
  seccomp -> sb [label="  filtered syscalls"];
  sb -> kernel [role="risk", style=dashed];
  kernel -> hw;
}
