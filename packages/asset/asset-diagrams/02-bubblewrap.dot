digraph Bubblewrap {
  rankdir=TB;
  splines=false;
  nodesep=0.3;
  ranksep=0.5;
  margin=0.3;

  node [shape=box, style="rounded,filled", fontsize=12, width=3, height=0.5];
  edge [fontsize=9, penwidth=1.5, arrowsize=0.7];

  label="Bubblewrap — Linux Namespace Isolation";
  labelloc=t;
  fontsize=14;

  agent [label="AI Agent", role="actor"];
  env [label="Environment reduced to an allowlist (--unsetenv)", fontsize=10];
  ns [label="PID | IPC | UTS | cgroup namespaces\nnet namespace unless network is host", fontsize=10];
  mounts [label="Deny-default mounts: workdir (rw), repo and config paths (ro)\nminimal /dev, /proc, tmpfs /tmp and HOME", fontsize=10];
  pass [label="hostPassthrough only: /usr /lib /lib64 /bin /etc (ro)", role="note", fontsize=10];
  sb [label="sandbox boundary", role="risk", style="rounded,filled,dashed", fontsize=10];
  kernel [label="Host Kernel (shared)", role="strong"];
  hw [label="Hardware", role="panel"];

  agent -> env;
  env -> ns;
  ns -> mounts;
  mounts -> sb [label="  all syscalls (shared kernel)"];
  sb -> kernel [role="risk", style=dashed];
  kernel -> hw;

  { rank=same; mounts; pass; }
  mounts -> pass [style=invis];
}
