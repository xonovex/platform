digraph Nix {
  rankdir=TB;
  splines=false;
  nodesep=0.3;
  ranksep=0.5;
  margin=0.3;

  node [shape=box, style="rounded,filled", fontsize=12, width=3, height=0.5];
  edge [fontsize=9, penwidth=1.5, arrowsize=0.7];

  label="bwrap × nix — flake.lock-pinned closure, mounted read-only";
  labelloc=t;
  fontsize=14;

  agent [label="AI Agent", role="actor"];
  env [label="closure PATH entries (the pinned tools)"];
  store [label="closure requisites ONLY (nix path-info -r), read-only\nNOT the whole /nix/store, no nix daemon socket", fontsize=10];
  ns [label="PID | IPC | UTS | cgroup | net namespaces", fontsize=10];
  sb [label="sandbox boundary (deny-default: --clearenv, sandbox-local HOME)", role="risk", style="rounded,filled,dashed", fontsize=10];
  kernel [label="Host Kernel (shared)", role="strong"];
  hw [label="Hardware", role="panel"];

  agent -> env [label="  binaries from the closure"];
  env -> store;
  store -> ns;
  ns -> sb [label="  all syscalls (shared kernel)"];
  sb -> kernel [role="risk", style=dashed];
  kernel -> hw;
}
