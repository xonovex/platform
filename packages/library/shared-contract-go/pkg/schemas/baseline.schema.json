{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.xonovex.com/agent/baseline.schema.json",
  "title": "Eval baseline",
  "description": "The pass rates a later run of the same protocol and profile is compared with.",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "version": {"$ref": "common.schema.json#/$defs/version"},
    "protocol": {"$ref": "results.schema.json#/$defs/protocol"},
    "profile": {"$ref": "common.schema.json#/$defs/identifier"},
    "inputsDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "recordedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "tolerance": {
      "description": "The drop in pass rate below the baseline that still counts as equal.",
      "$ref": "common.schema.json#/$defs/ratio"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/identifier"},
          "condition": {"$ref": "common.schema.json#/$defs/condition"},
          "passRate": {"$ref": "common.schema.json#/$defs/ratio"},
          "runs": {"$ref": "common.schema.json#/$defs/positiveCount"}
        },
        "required": ["id", "passRate", "runs"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "protocol",
    "profile",
    "inputsDigest",
    "recordedAt",
    "tolerance",
    "cases"
  ],
  "additionalProperties": false
}
