{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.xonovex.com/agent/eval-trigger.schema.json",
  "title": "Trigger eval",
  "description": "Prompts that should or should not make an agent load one skill.",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "version": {"$ref": "common.schema.json#/$defs/version"},
    "skill": {"$ref": "common.schema.json#/$defs/identifier"},
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/query"}
    }
  },
  "required": ["version", "skill", "queries"],
  "additionalProperties": false,
  "$defs": {
    "split": {
      "description": "The part of the set a query belongs to: train to tune a description, validation to check it, test for a final held-out check.",
      "enum": ["train", "validation", "test"]
    },
    "query": {
      "type": "object",
      "allOf": [{"$ref": "common.schema.json#/$defs/prompt"}],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/identifier"},
        "shouldTrigger": {"type": "boolean"},
        "split": {"$ref": "#/$defs/split"},
        "rationale": {
          "description": "Why the query should or should not load the skill.",
          "$ref": "common.schema.json#/$defs/text"
        },
        "tags": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/identifier"},
          "uniqueItems": true
        }
      },
      "required": ["id", "shouldTrigger", "split"],
      "unevaluatedProperties": false
    }
  }
}
