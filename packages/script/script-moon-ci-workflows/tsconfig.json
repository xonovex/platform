{
  "extends": "@xonovex/ts-config-cli",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@xonovex/script-moon-common": ["../script-moon-common/src/index.ts"],
      "@xonovex/script-moon-common/*": ["../script-moon-common/src/*"],
      "@xonovex/script-moon-skill-eval-outputs": [
        "../script-moon-skill-eval-outputs/src/index.ts"
      ],
      "@xonovex/script-moon-skill-eval-outputs/*": [
        "../script-moon-skill-eval-outputs/src/*"
      ],
      "@xonovex/script-moon-skill-eval-triggers": [
        "../script-moon-skill-eval-triggers/src/index.ts"
      ],
      "@xonovex/script-moon-skill-eval-triggers/*": [
        "../script-moon-skill-eval-triggers/src/*"
      ]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../script-moon-common"
    },
    {
      "path": "../script-moon-skill-eval-outputs"
    },
    {
      "path": "../script-moon-skill-eval-triggers"
    }
  ]
}
