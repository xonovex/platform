{
  "extends": "@xonovex/ts-config-cli",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@xonovex/script-moon-common/*": ["../script-moon-common/src/*"],
      "@xonovex/script-moon-skill-catalog-common/*": [
        "../script-moon-skill-catalog-common/src/*"
      ]
    }
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../script-moon-common"
    },
    {
      "path": "../script-moon-skill-catalog-common"
    }
  ]
}
