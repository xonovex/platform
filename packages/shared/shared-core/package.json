{
  "name": "@xonovex/core",
  "version": "0.1.22",
  "description": "Core library for Xonovex TypeScript scripts (Node.js)",
  "type": "module",
  "license": "MIT",
  "author": "Xonovex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xonovex/platform.git",
    "directory": "packages/shared/shared-core"
  },
  "bugs": {
    "url": "https://github.com/xonovex/platform/issues"
  },
  "homepage": "https://github.com/xonovex/platform/tree/main/packages/shared/shared-core#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "xonovex-skill-compose": "./dist/src/skill-composition-cli.js",
    "xonovex-workflow-compose": "./dist/src/workflow-composition-runtime-cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./*": "./dist/src/*.js"
  },
  "dependencies": {
    "semver": "^7.7.3",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@xonovex/eslint-config-cli": "0.1.22",
    "@xonovex/prettier-config": "0.1.22",
    "@xonovex/ts-config-cli": "0.1.22",
    "@xonovex/vitest-config-node": "0.1.22",
    "@types/node": "^26.1.1",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "xonovex",
    "shared",
    "core"
  ]
}
