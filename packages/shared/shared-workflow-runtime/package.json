{
  "name": "@xonovex/workflow-runtime",
  "version": "0.1.22",
  "description": "Composable workflow runtime for triggers, executors, controls, evidence, and capability assessment",
  "type": "module",
  "license": "MIT",
  "author": "Xonovex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xonovex/platform.git",
    "directory": "packages/shared/shared-workflow-runtime"
  },
  "bugs": {
    "url": "https://github.com/xonovex/platform/issues"
  },
  "homepage": "https://github.com/xonovex/platform/tree/main/packages/shared/shared-workflow-runtime#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "xonovex-workflow": "./dist/src/cli.js"
  },
  "exports": {
    "./runtime": "./dist/src/runtime.js",
    "./command-runtime": "./dist/src/command-runtime.js",
    "./trigger-adapters": "./dist/src/trigger-adapters.js",
    "./maturity": "./dist/src/maturity.js"
  },
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@xonovex/eslint-config-cli": "0.1.22",
    "@xonovex/ts-config-cli": "0.1.22",
    "@xonovex/vitest-config-node": "0.1.22",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "xonovex",
    "workflow",
    "runtime",
    "composition"
  ]
}
