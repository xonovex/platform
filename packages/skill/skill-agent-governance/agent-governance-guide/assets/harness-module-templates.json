{
  "schemaVersion": "1.0.0",
  "deterministic": [
    {
      "id": "protected-path",
      "semanticIntent": "tool-before-use",
      "executorClass": "deterministic",
      "inputs": ["tool-name", "path"],
      "outputs": ["decision", "reason"],
      "timeoutMs": 30000,
      "sideEffects": "none",
      "concurrency": "reentrant",
      "failureMode": "fail-closed",
      "evidence": "provider-native hook execution reference",
      "capturesSensitiveContent": false
    },
    {
      "id": "secret-protection",
      "semanticIntent": "tool-before-use",
      "executorClass": "deterministic",
      "inputs": ["tool-name", "path", "content-metadata"],
      "outputs": ["decision", "reason"],
      "timeoutMs": 30000,
      "sideEffects": "none",
      "concurrency": "reentrant",
      "failureMode": "fail-closed",
      "evidence": "provider-native hook execution reference",
      "capturesSensitiveContent": false
    },
    {
      "id": "tool-policy",
      "semanticIntent": "tool-before-use",
      "executorClass": "deterministic",
      "inputs": ["tool-name", "arguments"],
      "outputs": ["decision", "reason"],
      "timeoutMs": 30000,
      "sideEffects": "none",
      "concurrency": "reentrant",
      "failureMode": "fail-closed",
      "evidence": "provider-native hook execution reference",
      "capturesSensitiveContent": false
    },
    {
      "id": "post-write-format",
      "semanticIntent": "tool-after-use",
      "executorClass": "deterministic",
      "inputs": ["changed-paths"],
      "outputs": ["result", "changed-paths"],
      "timeoutMs": 30000,
      "sideEffects": "workspace-write",
      "concurrency": "idempotent",
      "failureMode": "fail-visible",
      "evidence": "provider-native hook execution reference",
      "capturesSensitiveContent": false
    },
    {
      "id": "validation",
      "semanticIntent": "session-end",
      "executorClass": "deterministic",
      "inputs": ["revision", "validation-command"],
      "outputs": ["outcome", "evidence"],
      "timeoutMs": 30000,
      "sideEffects": "none",
      "concurrency": "reentrant",
      "failureMode": "fail-visible",
      "evidence": "provider-native hook execution reference",
      "capturesSensitiveContent": false
    },
    {
      "id": "audit",
      "semanticIntent": "session-observation",
      "executorClass": "deterministic",
      "inputs": ["event-metadata"],
      "outputs": ["native-reference"],
      "timeoutMs": 30000,
      "sideEffects": "provider-write",
      "concurrency": "idempotent",
      "failureMode": "fail-visible",
      "evidence": "provider-native hook execution reference",
      "capturesSensitiveContent": false
    },
    {
      "id": "context-injection",
      "semanticIntent": "session-start",
      "executorClass": "deterministic",
      "inputs": ["approved-context-references"],
      "outputs": ["additional-context"],
      "timeoutMs": 30000,
      "sideEffects": "none",
      "concurrency": "reentrant",
      "failureMode": "advisory",
      "evidence": "provider-native hook execution reference",
      "capturesSensitiveContent": false
    },
    {
      "id": "privileged-operation",
      "semanticIntent": "privileged-operation-before-authorization",
      "executorClass": "deterministic",
      "inputs": ["operation", "subject", "actor"],
      "outputs": ["decision", "reason", "evidence-request"],
      "timeoutMs": 30000,
      "sideEffects": "none",
      "concurrency": "reentrant",
      "failureMode": "fail-closed",
      "evidence": "provider-native hook execution reference",
      "capturesSensitiveContent": false
    }
  ],
  "modelEvaluator": {
    "id": "bounded-policy-evaluator",
    "executorClass": "model",
    "semanticIntent": "policy-evaluation",
    "explicitRunner": true,
    "fixedPurpose": "classify one proposed operation against supplied policy facts",
    "inputReferences": ["policy-version", "operation-subject", "context-facts"],
    "outputSchema": {
      "required": ["outcome", "reasons", "evidenceRequests"],
      "additionalProperties": false
    },
    "timeBudgetSeconds": 30,
    "tokenBudget": 2000,
    "costBudget": 1,
    "retryLimit": 0,
    "toolScope": [],
    "filesystemScope": [],
    "networkScope": ["selected-model-provider"],
    "secretScope": [],
    "failureMode": "fail-visible"
  },
  "agentLauncher": {
    "id": "bounded-specialist",
    "executorClass": "agent",
    "semanticIntent": "subagent-before-launch",
    "explicitLaunch": true,
    "maxDepth": 1,
    "timeBudgetSeconds": 120,
    "tokenBudget": 8000,
    "costBudget": 2,
    "retryLimit": 0,
    "toolScope": ["read"],
    "filesystemScope": ["workspace:read"],
    "networkScope": [],
    "secretScope": [],
    "dataScope": ["selected-workspace-files"],
    "authorityAttenuated": true,
    "recursion": "denied",
    "resultSchema": {
      "required": ["summary", "findings", "evidenceReferences"],
      "additionalProperties": false
    },
    "cancellation": "terminate-process-group",
    "killSwitch": true,
    "failureMode": "fail-visible"
  },
  "platformMappings": [
    {
      "platform": "claude-code",
      "nativePath": ".claude/settings.json or plugin hooks/hooks.json",
      "deterministic": "command",
      "modelEvaluator": "prompt on supported events or explicit command runner",
      "agentLauncher": "experimental agent handler or explicit command runner"
    },
    {
      "platform": "codex",
      "nativePath": ".codex/hooks.json or config.toml",
      "deterministic": "command",
      "modelEvaluator": "explicit command runner",
      "agentLauncher": "explicit command runner"
    },
    {
      "platform": "kiro",
      "nativePath": ".kiro/hooks/*.json",
      "deterministic": "command action",
      "modelEvaluator": "agent action or explicit command runner",
      "agentLauncher": "explicit bounded command runner"
    },
    {
      "platform": "copilot",
      "nativePath": ".github/hooks/*.json or policy/plugin hooks",
      "deterministic": "command or HTTPS handler",
      "modelEvaluator": "explicit command runner",
      "agentLauncher": "explicit bounded command runner"
    },
    {
      "platform": "pi",
      "nativePath": ".pi/extensions/*.ts or pinned package",
      "deterministic": "extension event handler",
      "modelEvaluator": "explicit extension runner",
      "agentLauncher": "explicit bounded child process"
    },
    {
      "platform": "opencode",
      "nativePath": ".opencode/plugins/*.ts or pinned npm plugin",
      "deterministic": "plugin hook",
      "modelEvaluator": "explicit plugin runner",
      "agentLauncher": "explicit bounded child process"
    }
  ]
}
