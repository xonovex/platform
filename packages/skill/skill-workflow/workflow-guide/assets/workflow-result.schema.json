{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xonovex.dev/schemas/workflow-result.schema.json",
  "title": "OperationResult",
  "description": "Human-independent result envelope returned by every workflow operation and workspace transaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "operation",
    "status",
    "summary",
    "request",
    "resolution",
    "output",
    "evidence",
    "effects",
    "unresolved",
    "uncertainty",
    "retry",
    "concurrency"
  ],
  "properties": {
    "contractVersion": {
      "const": "xonovex.workflow.result/v1"
    },
    "operation": {
      "$ref": "workflow-request.schema.json#/$defs/operation"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "partial", "blocked", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "$ref": "workflow-request.schema.json"
    },
    "resolution": {
      "$ref": "#/$defs/resolution"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    },
    "retry": {
      "$ref": "#/$defs/retry"
    },
    "concurrency": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concurrency"
      }
    },
    "resultDigest": {
      "type": "string",
      "minLength": 1,
      "description": "Optional content digest for exact same-conversation handoff; not a universal identity."
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "publish"
          }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "output": {
            "required": ["binding"],
            "not": {
              "required": ["inline"]
            },
            "properties": {
              "binding": {
                "properties": {
                  "intent": {
                    "const": "write"
                  }
                },
                "required": ["locator", "writeMode"]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "required": ["inline"],
            "not": {
              "required": ["binding"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reason"],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "explicit",
            "accepted-proposal",
            "inherited",
            "authoritative-context",
            "policy",
            "default",
            "inferred"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sourceBinding": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "selectedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "resolvedPerspective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "provenance",
        "questions",
        "criterionIds",
        "evidenceRequirements"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "criterionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resolvedCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "binding", "provenance", "evaluation"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "type": "string",
          "enum": ["binding", "advisory"]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "evaluation": {
          "type": "string",
          "enum": ["pass", "fail", "blocked", "not-evaluated"]
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "value", "status", "provenance"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["method", "perspective", "criterion"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["accepted", "declined", "pending"]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "selectionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "explicit",
            "exact-dependency",
            "semantic-requirement",
            "policy"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requestedBy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "matchedProvision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skillSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guide",
        "plugin",
        "implementationVersion",
        "packagePath",
        "sourcesPath",
        "provenance",
        "catalogContractVersion",
        "catalogDigest",
        "reason",
        "required",
        "status"
      ],
      "properties": {
        "guide": {
          "type": "string",
          "minLength": 1
        },
        "plugin": {
          "type": "string",
          "minLength": 1
        },
        "implementationVersion": {
          "type": "string",
          "minLength": 1
        },
        "packagePath": {
          "type": "string",
          "minLength": 1
        },
        "sourcesPath": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/selectionProvenance"
        },
        "provision": {
          "$ref": "#/$defs/matchedProvision"
        },
        "requestedRange": {
          "type": "string",
          "minLength": 1
        },
        "catalogContractVersion": {
          "const": "1.0.0"
        },
        "catalogDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["selected", "unavailable", "conflict"]
        },
        "override": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "capabilitySelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source", "reason", "required", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": ["provider", "runtime"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["selected", "unavailable", "conflict"]
        },
        "override": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "perspectives",
        "criteria",
        "proposals",
        "skills",
        "capabilities",
        "conflicts"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["strict", "assisted", "automatic"]
        },
        "method": {
          "$ref": "#/$defs/selectedValue"
        },
        "perspectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolvedPerspective"
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolvedCriterion"
          }
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposal"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skillSelection"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilitySelection"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "inline": {
          "$ref": "workflow-request.schema.json#/$defs/jsonValue"
        },
        "binding": {
          "$ref": "workflow-request.schema.json#/$defs/resourceBinding"
        }
      },
      "oneOf": [
        {
          "required": ["inline"],
          "not": {
            "required": ["binding"]
          }
        },
        {
          "required": ["binding"],
          "not": {
            "required": ["inline"]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observation"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "criterionId": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "$ref": "workflow-request.schema.json#/$defs/resourceBinding"
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "type": "string",
          "minLength": 1
        },
        "reproduction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not-required", "required", "approved", "denied", "unknown"]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "mode", "status", "target", "authorization"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["inspect", "preview", "apply"]
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "applied", "skipped", "failed", "unknown"]
        },
        "target": {
          "$ref": "workflow-request.schema.json#/$defs/resourceBinding"
        },
        "authorization": {
          "$ref": "#/$defs/authorization"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "$ref": "workflow-request.schema.json#/$defs/resourceBinding"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "impact"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "impact"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe", "boundary", "reconcileBeforeRetry"],
      "properties": {
        "safe": {
          "type": "boolean"
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "reconcileBeforeRetry": {
          "type": "boolean"
        }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "observedRevision", "status"],
      "properties": {
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "observedRevision": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["unchanged", "changed", "unknown"]
        }
      }
    }
  }
}
