          "identity": "integrated-profile",
          "includedResults": ["Planning", "Review", "QA", "Acceptance"],
          "preservedResults": ["Planning", "Review", "QA", "Acceptance"],
          "explicitProvider": "non-file-provider",
          "providerAvailable": true,
          "mandatoryControls": [
            {
              "id": "accepted-deliverable-evidence",
              "enforcementPoints": [{"supported": true, "guaranteed": true}]
            }
          ],
          "governance": {"profile": "governance-only-profile"}
        },
        "governanceProfile": {
          "identity": "governance-only-profile",
          "facets": [
            "lifecycle",
            "governance",
            "executor",
            "enforcement",
            "data",
            "telemetry",
            "distribution"
          ],
          "strengthening": "additive",
          "weakensMandatoryControl": false,
          "authorizedException": false,
          "adequateEnforcement": true
        },
        "capabilities": {
          "method": ["user-stories", "bdd"],
          "executor-class": ["deterministic", "model", "agent", "human"],
          "provider-port": [
            "result-provider",
            "policy",
            "evidence-and-telemetry"
          ],
          "governance-module": ["advisory", "evidence-producing"]
        },
        "requiredCapabilities": {
          "method": ["user-stories"],
          "executor-class": ["deterministic", "human"],
          "provider-port": ["result-provider", "policy"]
        },
        "modules": [{"id": "advisory-review", "conflictsWith": []}],
        "conflictResolution": false,
        "providers": [
          {"port": "result-provider", "available": true, "compatible": true},
          {"port": "policy", "available": true, "compatible": true},
          {
            "port": "evidence-and-telemetry",
            "available": true,
            "compatible": true
          }
        ],
        "mandatoryControls": [
          {
            "id": "accepted-deliverable-evidence",
            "enforcementPoints": [{"supported": true, "guaranteed": true}]
          }
        ]
      }
    },
