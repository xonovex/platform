{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xonovex.dev/schemas/workflow-request.schema.json",
  "title": "WorkflowRequest",
  "description": "Normalized request for one workflow operation or workspace transaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "operation",
    "subject",
    "selection",
    "effect",
    "output"
  ],
  "properties": {
    "contractVersion": {
      "const": "xonovex.workflow.request/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "description": "Optional invocation-local identifier; never a universal work identity."
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "subject": {
      "$ref": "#/$defs/resourceBinding"
    },
    "inputs": {
      "type": "object",
      "description": "Named supporting slots. Each resource retains its own provider, locator, revision, kind, schema, and intent.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/resourceBinding"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/resourceBinding"
            }
          }
        ]
      }
    },
    "destination": {
      "$ref": "#/$defs/resourceBinding",
      "description": "Publish-only domain-result destination."
    },
    "continuation": {
      "$ref": "#/$defs/resourceBinding",
      "description": "Exact persisted OperationResult or administrative WorkRecord used to resume work."
    },
    "selection": {
      "$ref": "#/$defs/semanticSelection"
    },
    "effect": {
      "$ref": "#/$defs/effectRequest"
    },
    "output": {
      "$ref": "#/$defs/outputSpec"
    },
    "invocation": {
      "$ref": "#/$defs/invocationContext"
    },
    "implementationOverrides": {
      "$ref": "#/$defs/implementationOverrides"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "publish"
          }
        },
        "required": ["operation"]
      },
      "then": {
        "required": ["destination"],
        "properties": {
          "effect": {
            "properties": {
              "mode": {
                "enum": ["preview", "apply"]
              }
            }
          },
          "destination": {
            "properties": {
              "intent": {
                "const": "write"
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": ["destination"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "execute"
          }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "effect": {
            "properties": {
              "mode": {
                "enum": ["inspect", "preview", "apply"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": ["workspace-create", "workspace-merge", "workspace-cleanup"]
          }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "effect": {
            "properties": {
              "mode": {
                "enum": ["preview", "apply"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "create",
              "review",
              "revise",
              "decide",
              "validate",
              "abandon",
              "workspace-abandon"
            ]
          }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "effect": {
            "properties": {
              "mode": {
                "const": "inspect"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "operation": {
      "type": "string",
      "enum": [
        "create",
        "review",
        "revise",
        "decide",
        "execute",
        "validate",
        "publish",
        "abandon",
        "workspace-create",
        "workspace-merge",
        "workspace-abandon",
        "workspace-cleanup"
      ]
    },
    "jsonValue": {
      "type": ["object", "array", "string", "number", "boolean", "null"]
    },
    "nativeLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "reference"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque provider-native locator."
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Exact observed source revision."
        },
        "expectedRevision": {
          "type": "string",
          "minLength": 1,
          "description": "Optimistic-concurrency precondition for a write."
        },
        "immutable": {
          "type": "boolean",
          "description": "True only when the provider-native reference is intrinsically immutable."
        }
      }
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "intent"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "enum": ["read", "write"]
        },
        "inline": {
          "$ref": "#/$defs/jsonValue"
        },
        "locator": {
          "$ref": "#/$defs/nativeLocator"
        },
        "writeMode": {
          "type": "string",
          "enum": ["create", "update"],
          "description": "Create must fail on collision; update requires an expected revision."
        }
      },
      "oneOf": [
        {
          "required": ["inline"],
          "not": {
            "required": ["locator"]
          }
        },
        {
          "required": ["locator"],
          "not": {
            "required": ["inline"]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "intent": {
                "const": "read"
              }
            },
            "required": ["intent", "locator"]
          },
          "then": {
            "not": {
              "required": ["writeMode"]
            },
            "properties": {
              "locator": {
                "anyOf": [
                  {
                    "required": ["revision"]
                  },
                  {
                    "required": ["immutable"],
                    "properties": {
                      "immutable": {
                        "const": true
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "write"
              }
            },
            "required": ["intent"]
          },
          "then": {
            "required": ["locator", "writeMode"]
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "write"
              },
              "writeMode": {
                "const": "update"
              }
            },
            "required": ["intent", "writeMode"]
          },
          "then": {
            "properties": {
              "locator": {
                "required": ["expectedRevision"]
              }
            }
          }
        }
      ]
    },
    "criterionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "binding"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "type": "string",
          "enum": ["binding", "advisory"]
        },
        "sourceInput": {
          "type": "string",
          "minLength": 1,
          "description": "Name of an exact input binding from which the criterion is inherited."
        }
      }
    },
    "semanticSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perspectives",
        "criteria",
        "roleLenses",
        "resolutionMode",
        "acceptedSuggestions"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "perspectives": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterionRequest"
          }
        },
        "roleLenses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolutionMode": {
          "type": "string",
          "enum": ["strict", "assisted", "automatic"],
          "default": "assisted"
        },
        "acceptedSuggestions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "effectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["inspect", "preview", "apply"]
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outputSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invocationContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "type": "string",
          "minLength": 1
        },
        "authorizationContext": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque host-supplied context identifier; never credentials or a self-asserted grant."
        }
      }
    },
    "exactImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "implementationOverrides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "capabilities"],
      "properties": {
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exactImplementation"
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exactImplementation"
          }
        }
      }
    }
  }
}
