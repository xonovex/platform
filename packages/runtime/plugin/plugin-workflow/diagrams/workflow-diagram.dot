digraph Workflow {
  graph [rankdir=TB, pad=0.3, nodesep=0.3, ranksep=0.4, splines=polyline, compound=true, newrank=true, fontsize=22];
  node [shape=box, style="rounded,filled", fontsize=17, margin="0.18,0.13"];
  edge [fontsize=15, penwidth=1.5, arrowsize=0.7];

  subgraph cluster_research {
    research_top [shape=point, width=0, height=0, label="", style=invis, group=phase_spine];
    research_bottom [shape=point, width=0, height=0, label="", style=invis, group=phase_spine];
    { rank=min; research_top; }
    { rank=max; research_bottom; }
    research_top -> research_bottom [style=invis, weight=10000];
    research_top -> setup [style=invis];
    research_note -> research_bottom [style=invis];
    graph [label="1. Research and decisions", style=rounded, role=panel, margin=20, sortv=1];

    setup [label="Select harness, model and sandbox"];
    research [label="researching-changes\nExplore code, viability and alternatives"];
    decide [label="settling-questions\nResolve questions and agree direction"];
    proceed [label="Proceed?", role=decision];
    to_planning [label="2. Create and review a plan", role=strong];
    stop_research [label="Not pursued", role=terminal];
    research_note [role=note, label="Each box names the skill that owns the step.\nNew sessions are optional. Reconstruct context\nwhen resuming. Skills do not grant authority\nto push or perform other restricted actions."];

    setup -> research -> decide -> proceed;
    proceed -> to_planning [label="Yes"];
    proceed -> stop_research [label="No"];
    research_retry_top [shape=point, width=0, height=0, label="", style=invis, group=research_retry];
    research_retry_bottom [shape=point, width=0, height=0, label="", style=invis, group=research_retry];
    { rank=same; research_retry_top; research; }
    { rank=same; research_retry_bottom; proceed; }
    research_retry_top -> research [style=invis];
    research_retry_bottom -> proceed [style=invis];
    proceed:w -> research_retry_bottom [arrowhead=none, constraint=false, style=dashed, role=retry];
    research_retry_top -> research_retry_bottom [label="Investigate", arrowhead=none, weight=100, style=dashed, role=retry];
    research_retry_top -> research:w [constraint=false, style=dashed, role=retry];
    to_planning -> research_note [style=invis];
  }

  subgraph cluster_planning {
    planning_top [shape=point, width=0, height=0, label="", style=invis, group=phase_spine];
    planning_bottom [shape=point, width=0, height=0, label="", style=invis, group=phase_spine];
    { rank=min; planning_top; }
    { rank=max; planning_bottom; }
    planning_top -> planning_bottom [style=invis, weight=10000];
    planning_top -> create [style=invis];
    planning_note -> planning_bottom [style=invis];
    graph [label="2. Create and review a plan", style=rounded, role=panel, margin=20, sortv=2];

    create [label="writing-plan\nDefine criteria; use BDD or TDD when appropriate"];
    critique [label="critiquing-plan\nIndependent review"];
    review [label="Review outcome?", role=decision];
    revise [label="revising-plan\nApply feedback"];
    reject [label="approving-plan\nRecord rejection and reason"];
    accept [label="approving-plan\nRecord approval"];
    rejected [label="Rejected\nStop or return to revising-plan", role=terminal];
    expand [label="defining-subplans (optional)\nSplit work and identify parallel groups"];
    commit_plan [label="Core: using-git\nCommit plans when persisted"];
    to_execution [label="3. Implement and validate", role=strong];
    planning_note [role=note, label="Open decision: use settling-questions, then revise.\nStatus metadata alone does not authorize work."];

    create -> critique -> review;
    review -> revise [label="Revise"];
    review_retry_top [shape=point, width=0, height=0, label="", style=invis, group=review_retry];
    review_retry_bottom [shape=point, width=0, height=0, label="", style=invis, group=review_retry];
    { rank=same; review_retry_top; critique; }
    { rank=same; review_retry_bottom; revise; reject; accept; }
    revise -> reject -> accept [style=invis, weight=100];
    review_retry_top -> critique [style=invis];
    review_retry_bottom -> revise [style=invis];
    revise:w -> review_retry_bottom [arrowhead=none, constraint=false, style=dashed, role=retry];
    review_retry_top -> review_retry_bottom [arrowhead=none, weight=100, style=dashed, role=retry];
    review_retry_top -> critique:w [constraint=false, style=dashed, role=retry];
    review -> reject [label="Reject"];
    reject -> rejected;
    review -> accept [label="Accept"];
    accept -> expand -> commit_plan -> to_execution;
    to_execution -> planning_note [style=invis];
  }

  subgraph cluster_execution {
    execution_top [shape=point, width=0, height=0, label="", style=invis, group=phase_spine];
    execution_bottom [shape=point, width=0, height=0, label="", style=invis, group=phase_spine];
    { rank=min; execution_top; }
    { rank=max; execution_bottom; }
    execution_top -> execution_bottom [style=invis, weight=10000];
    execution_top -> worktree [style=invis];
    execution_note -> execution_bottom [style=invis];
    graph [label="3. Implement and validate", style=rounded, role=panel, margin=20, sortv=3];

    worktree [label="Core: using-git (optional)\nEnter worktree and associate the plan"];
    mode [label="Execution mode?", role=decision];
    continuation [label="implementing-plan\nRequest apply; implement one target\nLoad plan context and relevant skills"];
    delegation [label="delegating-plan\nBrief agents; independently verify work\nCommit per item or batch as requested"];
    validate [label="validating-plan\nCheck criteria and report evidence"];
    passes [label="Checks pass?", role=decision];
    update [label="implementing-plan\nRefresh progress and evidence\nPersist with plan when requested"];
    next [label="Next step?", role=decision];
    to_quality [label="4. Quality and delivery", role=strong];
    to_pause [label="5. Closeout\nPause or hand off", role=strong];
    execution_note [role=note, label="Delegation: sequential or parallel ordering.\nParallel groups require disjoint file sets.\nUse isolated worktrees when needed.\nFinish dependencies before the next group.\nAbandoning a worktree: use panel 4."];

    worktree -> mode;
    mode -> continuation [label="One target"];
    mode -> delegation [label="Roadmap"];
    continuation -> validate;
    delegation -> validate;
    validate -> passes;
    execution_retry_top [shape=point, width=0, height=0, label="", style=invis, group=execution_retry];
    execution_retry_bottom [shape=point, width=0, height=0, label="", style=invis, group=execution_retry];
    { rank=same; execution_retry_top; mode; }
    { rank=same; execution_retry_bottom; passes; }
    execution_retry_top -> mode [style=invis];
    execution_retry_bottom -> passes [style=invis];
    passes:w -> execution_retry_bottom [arrowhead=none, constraint=false, style=dashed, role=retry];
    execution_retry_top -> execution_retry_bottom [label="Fix and retry", arrowhead=none, weight=100, style=dashed, role=retry];
    execution_retry_top -> mode:w [constraint=false, style=dashed, role=retry];
    passes -> update [label="Yes"];
    update -> next;
    execution_resume_top [shape=point, width=0, height=0, label="", style=invis, group=execution_resume];
    execution_resume_bottom [shape=point, width=0, height=0, label="", style=invis, group=execution_resume];
    { rank=same; mode; execution_resume_top; }
    { rank=same; next; execution_resume_bottom; }
    mode -> execution_resume_top [style=invis];
    next -> execution_resume_bottom [style=invis];
    next:e -> execution_resume_bottom [arrowhead=none, constraint=false, style=dashed, role=retry];
    execution_resume_top -> execution_resume_bottom [label="More work", arrowhead=none, weight=100, style=dashed, role=retry];
    execution_resume_top -> mode:e [constraint=false, style=dashed, role=retry];
    next -> to_quality [label="Complete"];
    next -> to_pause [label="Pause"];
    to_quality -> execution_note [style=invis];
  }

  subgraph cluster_delivery {
    delivery_top [shape=point, width=0, height=0, label="", style=invis, group=phase_spine];
    delivery_bottom [shape=point, width=0, height=0, label="", style=invis, group=phase_spine];
    { rank=min; delivery_top; }
    { rank=max; delivery_bottom; }
    delivery_top -> delivery_bottom [style=invis, weight=10000];
    delivery_top -> quality [style=invis];
    to_closeout -> delivery_bottom [style=invis];
    graph [label="4. Quality and delivery", style=rounded, role=panel, margin=20, sortv=4];

    quality [label="Core: auditing-code-quality\nAudit simplification and hardening"];
    quality_result [label="Findings?", role=decision];
    fixes [label="3. Implement bounded fixes\n1. Research broader changes", role=strong];
    // The style pass writes subgraphs before loose nodes. This subgraph keeps
    // the audit nodes ahead of the delivery rank, so the fixes handoff stays
    // below "Findings?" and left of "Delivery path?".
    subgraph quality_audit { quality; quality_result; fixes; }
    delivery [label="Delivery path?", role=decision];
    merge [label="Core: using-git\nMerge the worktree into its parent"];
    abandon [label="Core: using-git\nAbandon: record reason; preserve lessons"];
    abandoned [label="Work abandoned\n6. Reflect on lessons", role=terminal];
    integrated [label="validating-plan\nCheck integrated work on parent"];
    integration_passes [label="Checks pass?", role=decision];
    parent_fix [label="3. Fix on parent\nThen repeat integrated validation", role=strong];
    cleanup [label="Core: using-git (optional)\nRemove remaining eligible worktrees"];
    commit [label="Core: using-git\nCommit; push only when requested"];
    publish [label="Optional publication\nGitHub / GitLab integration\nOpen a pull or merge request"];
    review_code [label="Core: reviewing-code\nReview code and address findings"];
    review_ready [label="Review and checks pass?", role=decision];
    review_fixes [label="3. Apply review fixes\nValidate, commit and repeat review", role=strong];
    land [label="Integrations: GitHub / GitLab\nMerge through repository controls"];
    to_closeout [label="5. Closeout", role=strong];

    quality -> quality_result;
    quality_result -> fixes [label="Changes needed"];
    quality_result -> delivery [label="Ready"];
    delivery -> merge [label="Worktree"];
    delivery -> abandon [label="Abandon"];
    abandon -> abandoned;
    delivery_bypass_top [shape=point, width=0, height=0, label="", style=invis, group=delivery_bypass];
    delivery_bypass_bottom [shape=point, width=0, height=0, label="", style=invis, group=delivery_bypass];
    { rank=same; delivery; delivery_bypass_top; }
    { rank=same; commit; delivery_bypass_bottom; }
    delivery -> delivery_bypass_top [style=invis];
    commit -> delivery_bypass_bottom [style=invis];
    delivery:e -> delivery_bypass_top [arrowhead=none, constraint=false];
    delivery_bypass_top -> delivery_bypass_bottom [label="No worktree", arrowhead=none, weight=100];
    delivery_bypass_bottom -> commit:e [constraint=false];
    merge -> integrated -> integration_passes;
    integration_passes -> parent_fix [label="No"];
    integration_passes -> cleanup [label="Yes"];
    cleanup -> commit;
    commit -> to_closeout [label="Local delivery"];
    commit -> publish [label="Publication requested"];
    publish -> review_code -> review_ready;
    review_ready -> review_fixes [label="No"];
    review_ready -> land [label="Yes"];
    land -> to_closeout;
  }

  subgraph cluster_closeout {
    closeout_top [shape=point, width=0, height=0, label="", style=invis, group=phase_spine];
    closeout_bottom [shape=point, width=0, height=0, label="", style=invis, group=phase_spine];
    { rank=min; closeout_top; }
    { rank=max; closeout_bottom; }
    closeout_top -> closeout_bottom [style=invis, weight=10000];
    closeout_top -> followup [style=invis];
    followup_note -> closeout_bottom [style=invis];
    graph [label="5. Closeout and follow-up", style=rounded, role=panel, margin=20, sortv=5];

    followup [label="closing-plan\nCompleted, paused or handed-over work"];
    record [label="Return status, evidence, decisions,\nremaining work and follow-up seeds\nPublish separately when requested"];
    outcome [label="Outcome?", role=decision];
    complete [label="Feature complete", role=strong];
    paused [label="Paused / handed over\nResume through panel 3", role=terminal];
    distill [label="distilling-plan (optional)\nCompleted implementation\nto replayable skill suite"];
    followup_note [role=note, label="Follow-up seeds: panel 2, writing-plan.\nUnresolved research: panel 1, researching-changes.\nDistillation captures a replayable implementation,\nnot just the session lessons in panel 6."];

    followup -> record -> outcome;
    outcome -> complete [label="Done"];
    outcome -> paused [label="Pause / handoff"];
    complete -> distill;
    distill -> followup_note [style=invis];
  }

  subgraph cluster_learning {
    graph [label="6. Continuous learning (any phase)", style=rounded, role=panel, margin=20, sortv=6];

    lessons [label="Session lessons\nFrom any phase, including stopped work"];
    extract [label="reflecting-on-sessions (optional)\nExtract lessons separately"];
    instructions [label="reflecting-on-sessions\nUpdate relevant AGENTS.md files"];
    skills [label="reflecting-on-sessions\nUpdate reusable skills"];
    guidance [label="Improved guidance\nfor future sessions", role=positive];
    simplify [label="Agentic Plugin, as needed\nauthoring-instructions\nauthoring-skills"];
    learning_note [role=note, label="The integration operations extract and apply directly.\nIntegrate stored reflections after a separate extraction.\nGray arrows: normal flow. Dashed blue: retry.\nDark handoff boxes name another numbered panel."];

    lessons -> instructions [label="Apply directly"];
    lessons -> skills [label="Apply directly"];
    lessons -> extract [label="Extract separately"];
    extract -> instructions [label="Stored reflections"];
    extract -> skills [label="Stored reflections"];
    instructions -> guidance;
    skills -> guidance;
    guidance -> simplify;
    simplify -> learning_note [style=invis];
  }

  research_bottom -> planning_top [ltail=cluster_research, lhead=cluster_planning, weight=10000, minlen=2];
  planning_bottom -> execution_top [ltail=cluster_planning, lhead=cluster_execution, weight=10000, minlen=2];
  execution_bottom -> delivery_top [ltail=cluster_execution, lhead=cluster_delivery, weight=10000, minlen=2];
  delivery_bottom -> closeout_top [ltail=cluster_delivery, lhead=cluster_closeout, weight=10000, minlen=2];
  { rank=same; delegation; lessons; }
  delegation -> lessons [style=invis, weight=10];
  delegation:e -> lessons:w [ltail=cluster_execution, lhead=cluster_learning, constraint=false, style=dotted];

}
