digraph diagram {
  graph [rankdir=LR, pad=0.2, nodesep=0.25, ranksep=0.35, splines=polyline]
  node [shape=box, style="rounded,filled", fontsize=19, margin="0.17,0.14"]
  edge [penwidth=1.5, arrowsize=0.7]

  research [label="Research\nand decide"]
  plan [label="Plan\nand review"]
  cycle [label="Implement\nand validate", role="strong"]
  quality [label="Quality\nand delivery"]
  done [label="Closeout\nand follow-up", role="strong"]

  research -> plan -> cycle -> quality -> done
}
