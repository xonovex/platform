digraph diagram {
  graph [bgcolor="white", rankdir=LR, pad=0.2, nodesep=0.25, ranksep=0.35, splines=polyline]
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=19, color="#0063d3", fillcolor="#eef6ff", fontcolor="#1d253c", margin="0.17,0.14"]
  edge [color="#3f5f90", penwidth=1.5, arrowsize=0.7]

  research [label="Research\nand decide"]
  plan [label="Plan\nand review"]
  cycle [label="Implement\nand validate", fillcolor="#fff3bf", color="#a76d00"]
  quality [label="Quality\nand delivery"]
  done [label="Closeout\nand follow-up", fillcolor="#fff3bf", color="#a76d00"]

  research -> plan -> cycle -> quality -> done
}
