{
  "type": "object",
  "required": ["type", "schema", "work", "worktree_hash", "source", "results"],
  "properties": {
    "type": {"const": "Workflow Verdict"},
    "schema": {"const": "workflow/verdict/1"},
    "work": {"$ref": "workflow/common#/$defs/workId"},
    "worktree_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "source": {"type": "string", "enum": ["independent", "self-check"]},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "result", "evidence"],
        "properties": {
          "criterion": {"type": "string", "pattern": "^c[0-9]+$"},
          "result": {"type": "string", "enum": ["pass", "fail", "blocked"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [{"$ref": "workflow/common#/$defs/header"}]
}
