{
  "type": "object",
  "required": ["type", "schema", "plan", "lenses", "blind"],
  "properties": {
    "type": {"const": "Workflow Critique"},
    "schema": {"const": "workflow/critique/1"},
    "plan": {
      "allOf": [{"$ref": "workflow/common#/$defs/conceptId"}, {"x-concept": ""}]
    },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["red-team", "pre-mortem", "falsify", "steelman"]
      }
    },
    "blind": {"type": "boolean"}
  },
  "allOf": [{"$ref": "workflow/common#/$defs/header"}]
}
