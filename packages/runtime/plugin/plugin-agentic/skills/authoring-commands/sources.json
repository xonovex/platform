      "reviewedAt": "2026-05-13",
      "feeds": ["references/harness-formats.md"],
      "usage": [
        "`references/harness-formats.md` → Claude Code matrix row, Argument syntax axis, Frontmatter fields axis, Migration Notes"
      ],
      "claims": [
        {
          "id": "claim-1",
          "statement": "`.claude/commands/<name>.md` (legacy) and `.claude/skills/<name>/SKILL.md` (recommended) locations"
        },
        {
          "id": "claim-2",
          "statement": "YAML frontmatter fields: `description`, `allowed-tools`, `argument-hint`, `model`, `disable-model-invocation`"
        },
        {
          "id": "claim-3",
          "statement": "`$ARGUMENTS`, `$1`, `$2` argument substitution"
        },
        {
          "id": "claim-4",
          "statement": "`` !`cmd` `` inline shell execution"
        },
        {
          "id": "claim-5",
          "statement": "Skill / command merger in v2.1.101: skill wins on name collision"
        }
      ]
    },
    {
