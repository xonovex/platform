digraph VariationAxes {
  rankdir=TB;
  newrank=true;
  nodesep=0.45;
  ranksep=0.7;

  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9];

  composition [label="Workflow composition\nselect each dimension independently", shape=house, fillcolor="#e8d5f5"];

  trigger [label="Trigger\nmanual · harness hook · CI/CD\nschedule · webhook · domain event", fillcolor="#dcecff"];
  executor [label="Executor\nscript · script + LLM\nagent + workflow skill · custom", fillcolor="#dcecff"];
  host [label="Host\nlocal · harness · CI runner\nKubernetes · custom", fillcolor="#dcecff"];
  controls [label="Controls (0..n)\nplugin + observe | enforce\nbefore | after", fillcolor="#ffe4cc"];
  evidence [label="Evidence (0..n)\nplugin + ignore | fail", fillcolor="#d9f2e6"];
  maturity [label="Maturity (optional)\ncaller-defined capability model\nA1/A2/A3 have no built-in meaning", fillcolor="#f3e6ff"];

  composition -> trigger [style=invis];
  composition -> executor [style=invis];
  composition -> host [style=invis];
  composition -> controls [style=invis];
  composition -> evidence [style=invis];
  composition -> maturity [style=invis];
  {rank=same; trigger; executor; host;}
  {rank=same; controls; evidence; maturity;}

  rule [label="No dimension silently selects another\nA hook does not add a control · an agent does not imply maturity\na host policy does not become workflow governance", shape=note, fillcolor="#fff3cd"];
  maturity -> rule [style=invis];
}
