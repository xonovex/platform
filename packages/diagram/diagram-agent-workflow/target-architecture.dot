digraph AgenticTargetArchitecture {
  // Target architecture: commands as reusable workflow steps, driven
  // manually, semi-agentically, or autonomously from the same definitions.
  rankdir=TB;
  compound=true;
  newrank=true;
  splines=polyline;
  nodesep=0.5;
  ranksep=0.9;

  node [shape=box, style="rounded,filled", fillcolor=white, fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9];

  // Triggers and outer loops
  subgraph cluster_signals {
    label="Triggers & Outer Loops";
    style=filled;
    fillcolor="#fdf0f0";

    human [label="Human\n(slash command, approval,\nveto, escalation target)", shape=house, fillcolor=lavender];
    schedule [label="Schedule\n(audits, evals,\nreflect integration)", shape=cds, fillcolor="#ffe6cc"];
    sensor_ci [label="Sensor: CI\n(pipeline failed,\nMR feedback)", shape=cds, fillcolor="#ffe6cc"];
    sensor_obs [label="Sensor: Observability\n(obs Alertmanager receiver:\nMimir ruler alerts, Falco,\nFlagger canary events)", shape=cds, fillcolor="#ffe6cc"];

    ci_sentinel [label="(CI Sentinel agent:\nclassify failure,\npropose fix workflow)", shape=ellipse, fillcolor=lightyellow];
    obs_analyst [label="(Observability Analyst agent:\ntriage, read-only\nLoki / Mimir / Tempo)", shape=ellipse, fillcolor=lightyellow];
    fleet [label="(Fleet Supervisor:\nstuck runs, budgets,\nescalation)", shape=ellipse, fillcolor=lightyellow];
  }

  // Orchestration
  subgraph cluster_orchestration {
    label="Orchestration (deterministic control flow - no LLM decides the graph)";
    style=filled;
    fillcolor="#eef6ff";

    wf_def [label="Workflow definitions\nworkflows/*.yml\n(steps, gates, loops,\nmax iterations, budgets)", shape=note];
    orchestrator [label="Orchestrator (one semantics, three interpreters)\nL1: workflow-next command (in-session)\nL2: agent-cli workflow run (headless loop)\nL3: WorkflowRun controller (agent-operator-go,\ndeployed on the ci cluster)"];
    gate [label="Gate\npolicy: manual | assisted | auto\naudit trail per decision", shape=diamond, fillcolor=lightcoral];
    reviewer [label="(Gate reviewer agents:\nplan-critique,\nplan-validate, ...)", shape=ellipse, fillcolor=lightyellow];
  }

  // State
  subgraph cluster_state {
    label="Workflow State (git is the source of truth)";
    style=filled;
    fillcolor="#f7f7ee";

    plans [label="plans/<plan>.md + subplans\n(frontmatter: status, skills,\nparallel groups)", shape=note];
    journal [label="plans/<plan>/runs/*.yaml\n(step results: status, evidence,\nartifacts, suggested next)", shape=note];
  }

  // Steps
  subgraph cluster_steps {
    label="Steps (reusable at every maturity level)";
    style=filled;
    fillcolor="#e8f0fe";

    steps [label="Commands as steps\nplan-*, git-commit, reflect-*\n+ result contract (machine-readable outcome)", fillcolor=lightblue];
    skills [label="Skills\n(procedure source of truth,\nsteps stay thin)"];
  }

  // Runners
  subgraph cluster_runners {
    label="Runners (same step, three homes)";
    style=filled;
    fillcolor="#f0eafe";

    r_session [label="Interactive session\n(today's default)"];
    r_headless [label="agent-cli run, headless\n(isolation x provision x network,\npinned nix toolchain)"];
    r_cluster [label="AgentRun Job on the ci cluster\n(AgentWorkspace worktrees, gVisor/Kata,\ndeny-all egress + model-provider\nAPI exception)"];
  }

  // Delivery and GitOps boundary
  subgraph cluster_delivery {
    label="Delivery (agents stop at the PR - GitOps deploys; Talos/Cilium fleet, staging not shown)";
    style=filled;
    fillcolor="#e6ffe6";

    pr [label="PR / MR"];
    gitlab_ci [label="GitLab CI (ci cluster):\nrunner + autoscaler, Trivy,\ncosign v3 keyless signing"];
    flux [label="Flux\n(standalone per cluster)", shape=cds, fillcolor=lightsteelblue];
    prod [label="main cluster:\ntenant namespaces, Flagger\nGateway API canary, Kyverno enforce"];
    obs [label="obs cluster:\nMimir / Loki / Tempo / Grafana\n(Alloy from all clusters;\nAlertmanager -> Discord / email)"];
    mgmt [label="mgmt cluster:\nfleet services (image automation,\nnotification aggregation) -\nholds no spoke credentials,\nhosts no agent stack"];
  }

  boundary_note [label="Boundary: no agent mutates a cluster.\nDeliverables move only as commits/PRs;\nruntime signals return only through sensors.", shape=note, fillcolor=lightyellow];

  // Trigger edges
  human -> orchestrator [label="start / resume"];
  schedule -> orchestrator [label="maintenance\nworkflows"];
  sensor_ci -> ci_sentinel;
  ci_sentinel -> orchestrator [label="open fix\nworkflow"];
  sensor_obs -> obs_analyst;
  obs_analyst -> orchestrator [label="open incident\nworkflow"];
  fleet -> orchestrator [label="pause /\nescalate"];
  fleet -> human [label="notify", style=dashed];

  // Orchestration edges
  wf_def -> orchestrator [label="shape"];
  plans -> orchestrator [label="state"];
  journal -> orchestrator [label="last results"];
  orchestrator -> gate [label="at each gate"];
  reviewer -> gate [label="recommendation"];
  human -> gate [label="approval\n(manual / assisted)", style=dashed];
  gate -> orchestrator [label="verdict\n(audited)"];

  // Dispatch to runners
  orchestrator -> r_session [label="L0 / L1"];
  orchestrator -> r_headless [label="L2"];
  orchestrator -> r_cluster [label="L3"];
  r_session -> steps [label="fresh agent session\nexecutes one step"];
  r_headless -> steps;
  r_cluster -> steps;

  // Step effects
  steps -> skills [label="consult", style=dashed];
  steps -> journal [label="write result"];
  steps -> plans [label="update status"];
  steps -> pr [label="git-commit --push"];

  // Delivery and feedback loops
  pr -> gitlab_ci [label="pipeline"];
  gitlab_ci -> pr [label="checks", style=dashed];
  pr -> flux [label="merge -> GitOps"];
  flux -> prod;
  flux -> mgmt [style=dashed];
  prod -> obs [label="telemetry"];
  gitlab_ci -> sensor_ci [label="events", style=dashed, constraint=false];
  obs -> sensor_obs [label="alerts / events", style=dashed, constraint=false];

  boundary_note -> pr [style=invis];
}
