digraph TargetArchitecture {
  rankdir=TB;
  compound=true;
  newrank=true;
  nodesep=0.5;
  ranksep=0.75;

  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9];

  owner [label="Composition owner\nselects only required plugins and behavior", shape=house, fillcolor="#e8d5f5"];

  subgraph cluster_ports {
    label="Small stable core";
    style=filled;
    fillcolor="#edf4ff";

    invocation [label="Invocation schema\nopen trigger + subject + operation + selections", fillcolor="#d9e8ff"];
    executor [label="Executor port\nexecute once", fillcolor="#d9e8ff"];
    control [label="Control port\nbefore/after · allow/deny/abstain", fillcolor="#ffe4cc"];
    evidence [label="Evidence port\nrecord event + return reference", fillcolor="#d9f2e6"];
  }

  subgraph cluster_adapters {
    label="Replaceable adapters";
    style=filled;
    fillcolor="#f8f3ff";

    triggers [label="Trigger adapters\nmanual · harness · CI/CD · provider", fillcolor="#dcecff"];
    executors [label="Executor adapters\nscript · script + LLM · agent + skill", fillcolor="#dcecff"];
    controls [label="Control plugins\napproval · budget · critique · custom", fillcolor="#ffe4cc"];
    sinks [label="Evidence sinks\nJSONL · provider · audit service", fillcolor="#d9f2e6"];
    hosts [label="Host adapters\nlocal · harness · CI · Kubernetes", fillcolor="#f3e6ff"];
  }

  owner -> invocation;
  triggers -> invocation;
  executors -> executor;
  controls -> control;
  sinks -> evidence;
  hosts -> invocation [style=dashed];

  kernel [label="Kernel enforcement only\nschema · registration · explicit capabilities\nenforcing denials · selected sink failure", fillcolor="#fff3cd"];
  invocation -> kernel;
  executor -> kernel;
  control -> kernel;
  evidence -> kernel;

  maturity [label="Derived maturity\noptional caller-owned capability model\nnever selects runtime behavior", shape=note, fillcolor="#f3e6ff"];
  kernel -> maturity [style=dashed, label="report"];
}
