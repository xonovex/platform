digraph TargetArchitecture {
  rankdir=TB;
  compound=true;
  newrank=true;
  splines=polyline;
  nodesep=0.5;
  ranksep=0.75;

  node [shape=box, style="rounded,filled", fillcolor=white, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9];

  actors [label="Accountable actors and automation\nhuman | deterministic coordinator | bounded model | bounded agent | external system", shape=house, fillcolor="#e8d5f5"];
  composition [label="Profile and catalog resolver\nadoption mode + modules + versions + dependencies\nauthority zones + permissions + data flow + limitations", fillcolor="#fff3cd"];
  actors -> composition [label="select / authorize"];

  subgraph cluster_contracts {
    label="Semantic Core";
    style=filled;
    fillcolor="#edf4ff";

    workflow [label="Workflow Plane\nlifecycle capabilities + exact results\nprovider ports + completion", fillcolor="#d9e8ff"];
    governance [label="Governance Plane\napplicability + policy + authority\nexceptions + executor bounds", fillcolor="#ffe4cc"];
    events [label="Semantic event intents\nportable meaning, no universal native format", fillcolor="#fff7e6"];
    providers [label="Provider ports\nresult | configuration | policy | evidence\ntelemetry | identity | artifact | deployment", fillcolor="#e5f5ff"];

    workflow -> governance [label="optional exact evidence", style=dashed];
    governance -> workflow [label="optional authorization", style=dashed];
    governance -> events;
    workflow -> providers;
    governance -> providers;
  }

  composition -> workflow [label="optional"];
  composition -> governance [label="optional"];

  subgraph cluster_execution {
    label="Execution and Native Integration";
    style=filled;
    fillcolor="#f8f3ff";

    executors [label="Executor contracts\ndeterministic | model | agent | human | external\nleast adaptive + explicit authority + validation"];
    native [label="Native adapters\nharness configuration/hooks/plugins\nprovider APIs and platform modules", fillcolor="#efe5ff"];
    external [label="External enforcement\nGitHub/GitLab/Azure DevOps/Bitbucket/Bitrise\nCI + repository + environment + identity + AWS", fillcolor="#ffd9d9"];
    runtime [label="Runtime boundary\nworkspace trust + sandbox/isolation\nfilesystem/network/secrets/model budgets\nconcurrency + cancellation + kill behavior", fillcolor="#f3e6ff"];

    executors -> runtime;
    native -> runtime;
    external -> runtime [label="privileged path"];
  }

  events -> native [label="versioned capability matrix"];
  governance -> executors [label="select + attenuate"];
  governance -> external [label="decision reference"];
  providers -> native [label="port implementation"];
  providers -> external [label="port implementation"];

  subgraph cluster_operations {
    label="Enablement, Evidence, and Feedback";
    style=filled;
    fillcolor="#eefbea";

    onboarding [label="Onboarding transaction\ndiscover → assess → preview → authorize\napply → verify → record", fillcolor="#dff5d8"];
    evidence [label="Provider-native evidence\nsubject + revision + source + policy/version\noutcome + freshness + sensitivity + limitations", shape=folder, fillcolor="#d9f2e6"];
    observability [label="Observability\nminimized traces/metrics/logs/events\ncorrelation + retention + access + cost", fillcolor="#d7f3f0"];
    feedback [label="Feedback and operations\ndrift + incidents + effectiveness + learning\ncanary + rollback + disable + retirement", shape=cds, fillcolor="#d5efe8"];

    onboarding -> evidence [label="configuration proof"];
    evidence -> observability [label="correlate"];
    observability -> feedback;
    feedback -> onboarding [label="reviewed update", style=dashed];
  }

  composition -> onboarding [label="effective preview"];
  runtime -> evidence [label="execution outcome"];
  native -> evidence [label="native reference"];
  external -> evidence [label="enforcement reference"];
  evidence -> workflow [label="selected result evidence", style=dashed];
  feedback -> governance [label="reviewed policy/profile change", style=dashed];

  invariant [label="Invariant\nDecision, enforcement, authorization, configuration, workflow result, and evidence stay distinct.\nSkills and capability declarations do not prove enforcement.\nCrosswalks organize review; they do not establish certification, equivalence, or legal compliance.", shape=note, fillcolor="#fff3cd"];
  invariant -> evidence [style=invis];
}
