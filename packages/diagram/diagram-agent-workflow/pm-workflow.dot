digraph PmWorkflow {
  rankdir=TB;
  compound=true;
  newrank=true;
  splines=polyline;
  nodesep=0.4;
  ranksep=0.7;

  node [shape=box, style="rounded,filled", fillcolor=white, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9];

  start [label="An accountable human\nauthority over an exact revision, never a job title", shape=house, fillcolor="#e8d5f5"];

  subgraph cluster_frame {
    label="1 · Frame  (optional — skip for an ask you can state in a sentence)";
    style=filled;
    fillcolor="#f7f7f7";

    discovery [label="discovery-run\nobservations, assumptions, unknowns\ndoes not force stories", fillcolor="#eaf6ff"];
    research [label="research-run\ncited evidence + provenance, kept distinct from synthesis\nuncertainty stays explicit — pricing it is your job", fillcolor="#eaf6ff"];
    formulation [label="formulation-run\ncandidate behavior, examples, constraints\ndefaults to --method neutral", fillcolor="#eaf6ff"];
    method [label="--method user-stories / bdd only when that is genuinely your team's method\nan explicitly selected method that is not installed fails visibly\nNo story-refine — removed in 6.0.0; discovery-run then formulation-run replace it", shape=note, fillcolor="#fff3cd"];

    discovery -> research -> formulation;
    formulation -> method [style=invis];
  }

  subgraph cluster_decide {
    label="2 · Decide  (one fork at a time — only for a choice you would regret re-litigating)";
    style=filled;
    fillcolor="#e8f0fe";

    decisioncreate [label="decision-create --authority-reference <actor>\nevidence · recommendation · authority kept separate\na model may recommend — a recommendation is not a decision", fillcolor="#d9e8ff"];
    decisioncritique [label="decision-critique --revision <rev>\nadversarial · FRESH session\npublishes findings; makes and revises nothing", fillcolor="#dff4ff"];
    decisionrevise [label="decision-revise --feedback <critique-ref>\nnew revision · preserves prior authority and evidence\nreopens authority when the material meaning changed", fillcolor="#dff4ff"];
    decisionaccept [label="decision-accept --revision <rev>  ◆ human gate\nsupplies the authority for one fork\na model may prepare the brief, never the authority action", fillcolor="#ffe4cc", penwidth=2];

    decisioncreate -> decisioncritique;
    decisioncreate -> decisionaccept [label="accept on first draft —\nat the cost of the adversarial reader", style=dashed];
    decisioncritique -> decisionrevise [label="findings"];
    decisionrevise -> decisioncritique [label="re-critique", style=dashed];
    decisioncritique -> decisionaccept [label="solid"];
    decisionrevise -> decisionaccept [label="revision N+1 →\na fresh gate"];
  }

  expdesign [label="experience-design-accept --revision <rev>  ◆ human gate\naccepts one exact design revision, where that authority is yours", fillcolor="#ffe4cc", penwidth=2];
  expowner [label="The UX lens owns experience-design-create / -critique / -revise;\nsolution-design-* belongs to the developer lens", shape=note, fillcolor="#fff3cd"];
  expdesign -> expowner [style=invis];

  authority [label="--authority-reference is a claim to be verified, not a credential\nactor, qualification, scope, and freshness are checked\nbefore the decision binds to the revision\n\n--executor human is selected because accountable judgment must own\nthe outcome, never because the work is hard; raising autonomy A0→A3\nnever converts it into a model executor\n\nSilence is never approval — an unanswered escalation falls back to\npause or abandon when its window expires; a timeout never advances a gate", shape=note, fillcolor="#fff3cd"];

  subgraph cluster_authorize {
    label="3 · Authorize — the plan gate";
    style=filled;
    fillcolor="#eefbe8";

    plandraft [label="plan-research / plan-create / plan-critique / plan-revise\nthe developer lens drafts and revises the plan", shape=note, fillcolor="#fff3cd"];
    planaccept [label="plan-accept <plan-ref> --revision <rev>  ◆ human gate\nsets status: approved — the gate between\n\"someone wrote a plan\" and \"the team builds it\"", fillcolor="#ffe4cc", penwidth=2];
    planreject [label="plan-reject <plan-ref> --revision <rev> --reason <text>  ◆ human gate\nrejecting is not deleting — the rejected revision\nand your rationale stay readable", fillcolor="#ffe4cc", penwidth=2];
    planrevise [label="plan-revise\nnew revision · status resets to pending-approval", fillcolor="#ddf5d5"];
    subplans [label="plan-subplans-create\nrefuses without status: approved", fillcolor="#ddf5d5"];
    carry [label="Approval binds to one exact revision and never carries forward\nIf you approved revision 3 and revision 4 exists, you have approved nothing\nA model may summarize the plan for you — it cannot fabricate the approval", shape=note, fillcolor="#fff3cd"];

    {rank=same; planaccept; planreject;}
    plandraft -> planaccept [label="revision N"];
    plandraft -> planreject [label="revision N"];
    planreject -> planrevise [label="--reason recorded"];
    planrevise -> planaccept [label="revision N+1 → a fresh gate", style=dashed, constraint=false];
    planaccept -> subplans [label="approved"];
    planrevise -> carry [style=invis];
  }

  build [label="Build and Ship — the developer lens owns all of it\nplan-continue / develop-run · git-commit · pr-create\nYou meet the workflow again at acceptance-decide", shape=note, fillcolor="#fff3cd"];

  subgraph cluster_signoff {
    label="4 · Sign off — acceptance  (the split is the point)";
    style=filled;
    fillcolor="#fff0e6";

    accvalidate [label="acceptance-validate <criteria-ref> --subject <ref> --revision <rev>\nASSEMBLES EVIDENCE — an agent may run this\nand it explicitly cannot sign off", fillcolor="#ffe9d9"];
    evidence [label="Reports each criterion satisfied, failed, partial, stale,\nnot applicable, unknown, or not evaluated · never coerces missing,\nskipped, cancelled, or timed-out evidence to passing — gaps arrive as gaps\nBounded model or agent help is marked advisory\nThe evidence half belongs to the QA lens", shape=note, fillcolor="#fff3cd"];
    accdecide [label="acceptance-decide <deliverable-ref> --revision <rev> --target <target> --evidence <ref>  ◆ human gate\nDECIDES — an authenticated human only, identified through the provider's own mechanism\naccept | accept-with-conditions | reject, bound to the exact subject,\ntarget, evidence, policy version, and expiry\nrejects a script, model, agent, unqualified actor, self-reviewer\nwhere independence is required, or copied provider identity", fillcolor="#ffe4cc", penwidth=2];

    accvalidate -> accdecide [label="evidence, gaps included"];
    accvalidate -> evidence [style=invis];
  }

  subgraph cluster_beyond {
    label="Beyond your gate — ops owns it";
    style=filled;
    fillcolor="#fff0e6";

    integration [label="integration-validate → integration-run\nprotected external enforcement point\nrevalidates every binding", fillcolor="#ffd6d6"];
    release [label="release-run → observe-run", fillcolor="#fff7e6"];
    mutation [label="Acceptance grants no target mutation by itself\nYour sign-off authorizes; it does not ship\nintegration-validate and integration-run revalidate\nevery binding at an external enforcement point", shape=note, fillcolor="#fff3cd"];

    integration -> release;
    integration -> mutation [style=invis];
  }

  start -> discovery [label="fuzzy problem", lhead=cluster_frame];
  start -> planaccept [label="well-understood ask ·\nno fork worth recording", style=dashed, lhead=cluster_authorize];
  formulation -> decisioncreate [label="a genuine fork", ltail=cluster_frame, lhead=cluster_decide];
  decisionaccept -> expdesign [label="when that authority is yours", style=dashed, ltail=cluster_decide];
  expdesign -> planaccept [style=dashed, lhead=cluster_authorize];
  decisionaccept -> plandraft [label="decided", ltail=cluster_decide, lhead=cluster_authorize];
  subplans -> build [ltail=cluster_authorize, label="the team builds it"];
  build -> accvalidate [lhead=cluster_signoff];
  accdecide -> integration [label="authorizes — does not ship", ltail=cluster_signoff, lhead=cluster_beyond, minlen=2];
  integration -> accdecide [label="changed bindings / passed expiry →\ndecide again", style=dashed, ltail=cluster_beyond, lhead=cluster_signoff];
  authority -> expdesign [style=invis];

  legend [label="A lens, not a role gate: no command knows a job title — each ◆ gate asks for authority over an exact revision, and a lens is only which of the 59 commands you run and which gates you answer for\n◆ = mandatory human gate (authenticated human only)   ·   dashed = optional / loop back / re-open   ·   grey = skippable stage\nNone of these four stages writes code   ·   approval never carries from revision N to N+1   ·   results pass by opaque native reference and exact --revision, not conversation memory", shape=note, fillcolor="#fff3cd"];
  legend -> start [style=invis];
}
