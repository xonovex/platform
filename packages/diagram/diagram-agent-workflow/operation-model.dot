digraph OperationModel {
  graph [
    bgcolor="white",
    fontname="Arial",
    fontsize=18,
    label="Composable workflow contract",
    labelloc=t,
    nodesep=0.35,
    pad=0.25,
    ranksep=0.55,
    splines=polyline
  ];
  node [
    color="#4b5563",
    fillcolor="white",
    fontname="Arial",
    fontsize=9,
    shape=box,
    style="rounded,filled"
  ];
  edge [
    color="#6b7280",
    fontname="Arial",
    fontsize=8
  ];

  subgraph cluster_request {
    color="#93c5fd";
    fillcolor="#eff6ff";
    label="Normalized WorkflowRequest";
    style="rounded,filled";

    operation_selection [
      label="operation\none stable verb"
    ];
    semantic_selection [
      label="semantic selection\nsubject/result kind · method\nrepeatable perspectives · criteria"
    ];
    resource_bindings [
      label="per-resource bindings\nnamed slot · provider · opaque reference\nrevision · kind · schema · intent"
    ];
    invocation_context [
      label="invocation context\ntrigger · executor · effect mode\nauthorization-context reference"
    ];
    derived_implementation [
      fillcolor="#ede9fe",
      label="derived implementation\ncatalog-selected skills · adapters · capabilities\nexact versions + provenance"
    ];

    {rank=same; operation_selection; semantic_selection;}
    {rank=same; resource_bindings; invocation_context;}
  }

  policy [
    fillcolor="#fef3c7",
    label="deterministic runtime policy\nauthority · approvals · idempotency · retries\nbudgets · audit · transition enforcement",
    penwidth=2,
    shape=component
  ];

  request_contract [
    fillcolor="#dbeafe",
    label="validated request\nlayers stay distinct",
    penwidth=2,
    shape=component
  ];

  subgraph cluster_operations {
    color="#86efac";
    fillcolor="#f0fdf4";
    label="Eight sibling operations — omit, repeat, parallelize, or compose";
    style="rounded,filled";

    operation [
      fillcolor="#dcfce7",
      label="selected operation",
      shape=ellipse
    ];
    create [label="create\ninline result"];
    review [label="review\ninline judgment"];
    revise [label="revise\ninline successor"];
    decide [label="decide\ninline outcome"];
    execute [label="execute\ninspect · preview · apply"];
    validate [label="validate\ninline evidence"];
    publish [fillcolor="#fef3c7", label="publish\npreview · apply"];
    abandon [label="abandon\ninline record"];

    {rank=same; create; review; revise; decide;}
    {rank=same; execute; validate; publish; abandon;}

    operation -> create [arrowhead=none];
    operation -> review [arrowhead=none];
    operation -> revise [arrowhead=none];
    operation -> decide [arrowhead=none];
    operation -> execute [arrowhead=none];
    operation -> validate [arrowhead=none];
    operation -> publish [arrowhead=none];
    operation -> abandon [arrowhead=none];
  }

  operation_result [
    fillcolor="#e0f2fe",
    label="inline OperationResult\nnormalized request · resolution · output · evidence\neffects · uncertainty · retry · concurrency",
    shape=folder
  ];

  domain_destination [
    fillcolor="#ffedd5",
    label="provider-owned domain result\nonly Publish writes",
    shape=cylinder
  ];

  bounded_effects [
    fillcolor="#fee2e2",
    label="bounded subject effects\nExecute apply only",
    shape=box3d
  ];

  subgraph cluster_workspace {
    color="#d1d5db";
    fillcolor="#f9fafb";
    label="Workspace transactions — exclusive effect boundaries";
    style="dashed,filled";

    workspace_create [label="workspace-create\ncreates only"];
    workspace_merge [label="workspace-merge\nintegrates only"];
    workspace_abandon [label="workspace-abandon\nrecords inline only"];
    workspace_cleanup [label="workspace-cleanup\nremoves only"];

    {rank=same; workspace_create; workspace_merge; workspace_abandon; workspace_cleanup;}
  }

  workspace_effects [
    fillcolor="#fee2e2",
    label="workspace provider effects\npreview/apply for create · merge · cleanup",
    shape=box3d
  ];

  work_record [
    fillcolor="#f3e8ff",
    label="provider-owned WorkRecord\npolicy-authorized administrative checkpoint\nnot domain-result publication",
    shape=folder
  ];

  operation_selection -> request_contract;
  semantic_selection -> request_contract;
  resource_bindings -> request_contract;
  invocation_context -> request_contract;
  derived_implementation -> request_contract;
  policy -> derived_implementation [label="resolves"];
  policy -> request_contract [label="constrains"];
  request_contract -> operation;
  operation -> operation_result;
  workspace_create -> operation_result;
  workspace_merge -> operation_result;
  workspace_abandon -> operation_result;
  workspace_cleanup -> operation_result;

  publish -> domain_destination [label="authorized write"];
  execute -> bounded_effects [label="apply"];
  workspace_create -> workspace_effects [label="create"];
  workspace_merge -> workspace_effects [label="integrate"];
  workspace_cleanup -> workspace_effects [label="remove"];
  policy -> domain_destination [label="authorizes"];
  policy -> bounded_effects [label="authorizes"];
  policy -> workspace_effects [label="authorizes"];
  policy -> work_record [label="checkpoints", style=dashed];
  operation_result -> work_record [label="administrative reference", style=dashed];

  legend [
    color="#f59e0b",
    fillcolor="#fffbeb",
    label="Every operation returns inline. Publish alone persists a domain result.\nEffect intent never grants authority.",
    shape=note
  ];
  work_record -> legend [style=invis];
}
