digraph ComposableWorkflow {
  rankdir=LR;
  compound=true;
  newrank=true;
  nodesep=0.45;
  ranksep=0.7;

  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9];

  native [label="Native event\nmanual · hook · CI/CD · schedule · webhook", fillcolor="#dcecff"];
  adapter [label="Trigger adapter\nauthenticate · minimize · normalize\nbind trusted template", fillcolor="#dcecff"];
  invocation [label="Invocation\nopen trigger kind · subject · operation\nplugin selections · required capabilities", shape=folder, fillcolor="#dff4ff"];

  subgraph cluster_kernel {
    label="Composable workflow runtime";
    style=filled;
    fillcolor="#f8f3ff";

    resolve [label="Composition root\nresolve registered plugins\ncheck required capabilities", fillcolor="#efe5ff"];
    before [label="Before controls\n0..n · observe | enforce", fillcolor="#ffe4cc"];
    execute [label="One executor plugin", fillcolor="#dcecff"];
    after [label="After controls\n0..n · observe | enforce", fillcolor="#ffe4cc"];
    sinks [label="Evidence sinks\n0..n · ignore | fail", fillcolor="#d9f2e6"];

    resolve -> before -> execute -> after -> sinks;
  }

  registry [label="Trusted registry\nexecutables · adapter config\ncapability declarations", shape=folder, fillcolor="#fff3cd"];
  host [label="Independent host\nprocess · harness · CI runner · Kubernetes", fillcolor="#f3e6ff"];
  maturity [label="Optional maturity assessment\ncaller-owned model · no runtime effect", fillcolor="#f3e6ff"];

  native -> adapter -> invocation -> resolve;
  registry -> resolve;
  host -> resolve [style=dashed, label="hosts"];
  sinks -> maturity [style=dashed, label="capabilities"];
}
