digraph AdoptionMap {
  rankdir=TB;
  newrank=true;
  nodesep=0.5;
  ranksep=0.7;

  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9];

  start [label="Start with one trigger + one executor", shape=house, fillcolor="#e8d5f5"];

  manual [label="Manual\n+ script", fillcolor="#dcecff"];
  ci [label="CI/CD hook\n+ script + LLM", fillcolor="#dcecff"];
  harness [label="Harness hook\n+ agent + workflow skill", fillcolor="#dcecff"];
  custom [label="Any trigger\n+ custom executor", fillcolor="#dcecff"];

  start -> manual;
  start -> ci;
  start -> harness;
  start -> custom;
  {rank=same; manual; ci; harness; custom;}

  host [label="Choose a host independently\nlocal · harness · CI · Kubernetes", fillcolor="#efe5ff"];
  controls [label="Optionally add controls\neach observe or enforce", fillcolor="#ffe4cc"];
  evidence [label="Optionally add evidence sinks\neach ignore or fail", fillcolor="#d9f2e6"];
  maturity [label="Optionally assess maturity\ndescriptive only", fillcolor="#f3e6ff"];

  manual -> host [style=invis];
  ci -> controls [style=invis];
  harness -> evidence [style=invis];
  custom -> maturity [style=invis];
  {rank=same; host; controls; evidence; maturity;}

  inspect [label="Explain the resolved composition before execution\nselected plugins · required capabilities · enforcement points", shape=note, fillcolor="#fff3cd"];
  controls -> inspect [style=invis];
}
