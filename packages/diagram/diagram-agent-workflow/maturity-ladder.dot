digraph CompositionMaturity {
  rankdir=LR;
  splines=polyline;
  nodesep=0.45;
  ranksep=0.7;

  node [shape=box, style="rounded,filled", fillcolor=white, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9];

  l0 [label="L0 — Explicit local use\nWorkflow plane: optional manual commands\nGovernance plane: optional advisory checks\nOnboarding: manual native setup\nEvidence: local/provider references with limitations", fillcolor="#e8f0fe"];
  l1 [label="L1 — Reusable composition\nWorkflow plane: named profiles and provider ports\nGovernance plane: semantic event intents + modules\nNative adapters: version/date matrices\nOnboarding: preview, consent, verify, rollback", fillcolor="#dcecff"];
  l2 [label="L2 — Independently enforced\nWorkflow plane: exact results and freshness\nGovernance plane: decision/enforcement separation\nExternal enforcement: repository, CI, environment, identity\nProvider-native evidence + drift detection", fillcolor="#d8f2e3"];
  l3 [label="L3 — Managed and measured\nWorkflow plane: organization-selected lifecycle profiles\nGovernance plane: non-weakening managed policy/modules\nOnboarding: canary, update, disable, rollback, retirement\nFeedback: incidents, effectiveness, reviewed learning", fillcolor="#ccebd8"];

  l0 -> l1 [label="declare contracts\nand limitations"];
  l1 -> l2 [label="add adequate native\nenforcement and evidence"];
  l2 -> l3 [label="add managed authority,\noperations, and feedback"];

  adoption [label="Adoption is composable at every level\nworkflow-only | governance-only | enablement-only\nexternal-enforcement-only | integrated", shape=note, fillcolor="#fff3cd"];
  adoption -> l0 [style=invis];

  selection [label="Execution selection at every level\ndeterministic script → script + bounded model → bounded agent\nhuman or external system when authority/ownership requires it\nNo hidden agent launch; authority only attenuates", shape=note, fillcolor="#f3e6ff"];
  selection -> l2 [style=invis];

  invariants [label="Invariants at every level\nNo universal hook parity, mandatory workflow YAML, or skills-as-enforcement claim\nPolicy decision, enforcement, and provider-native evidence remain separate\nExceptions and break glass are scoped, expiring, compensated, and reviewed\nCrosswalks are not certification or automatic compliance", shape=note, fillcolor="#ffe5e5"];
  invariants -> l3 [style=invis];

  native [label="Native adapters", shape=plaintext];
  enforcement [label="External enforcement", shape=plaintext];
  evidence [label="Provider-native evidence", shape=plaintext];
  onboarding [label="Onboarding", shape=plaintext];
  feedback [label="Feedback", shape=plaintext];
  native -> enforcement -> evidence -> onboarding -> feedback [style=invis];
}
