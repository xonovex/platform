{
  "address": ":8080",
  "admin_token_env": "DISPATCHER_ADMIN_TOKEN",
  "database_url_env": "DISPATCHER_DATABASE_URL",
  "apply_enabled": false,
  "body_limit_bytes": 2097152,
  "replay_window_seconds": 300,
  "worker_interval_ms": 1000,
  "request_timeout_ms": 15000,
  "shutdown_timeout_ms": 20000,
  "max_effect_attempts": 8,
  "tenants": {
    "github-production": {
      "provider": "github",
      "base_url": "https://api.github.com",
      "token_env": "GITHUB_APP_INSTALLATION_TOKEN",
      "webhook_secret_env": "GITHUB_WEBHOOK_SECRET",
      "repositories": ["xonovex/platform"],
      "effects": [
        "ticket.create",
        "ticket.update",
        "ticket.state",
        "kanban.add",
        "kanban.status",
        "kanban.archive",
        "context.publish",
        "review.publish",
        "deployment.create",
        "deployment.status"
      ],
      "bot_logins": ["xonovex-dispatcher[bot]"]
    },
    "gitlab-production": {
      "provider": "gitlab",
      "base_url": "https://gitlab.com",
      "token_env": "GITLAB_PROJECT_ACCESS_TOKEN",
      "webhook_signing_env": "GITLAB_WEBHOOK_SIGNING_TOKEN",
      "allow_legacy_webhook": false,
      "repositories": ["xonovex/platform"],
      "effects": [
        "ticket.create",
        "ticket.update",
        "ticket.state",
        "kanban.status",
        "context.publish",
        "review.publish",
        "deployment.create",
        "deployment.status",
        "deployment.approval"
      ],
      "bot_logins": ["xonovex-dispatcher"]
    }
  }
}
