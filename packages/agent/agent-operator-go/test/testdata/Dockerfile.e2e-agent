FROM docker.io/alpine/git:2.54.0@sha256:697cb1c85aefc5724febaec2202a974e0d66f6abb6be91a9a86d0c8757af692a
RUN addgroup -S -g 1000 agent \
    && adduser -S -D -u 1000 -G agent -h /home/agent agent \
    && printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/claude \
    && chmod +x /usr/local/bin/claude
USER 1000:1000
