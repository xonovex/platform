{
  "extends": "@xonovex/ts-config-cli",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "@xonovex/eslint-config-cli": [
        "../../config/eslint-config-cli/src/index.ts"
      ],
      "@xonovex/eslint-config-cli/*": ["../../config/eslint-config-cli/src/*"],
      "@xonovex/vitest-config-node": [
        "../../config/vitest-config-node/src/index.ts"
      ],
      "@xonovex/vitest-config-node/*": ["../../config/vitest-config-node/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "references": [
    {
      "path": "../../config/eslint-config-cli"
    },
    {
      "path": "../../config/vitest-config-node"
    }
  ]
}
