{
  "name": "xonovex-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/asset/*",
    "packages/config/*",
    "packages/documentation/*",
    "packages/library/*",
    "packages/runtime/plugin/*",
    "packages/tooling/cli/agent-cli-go",
    "packages/tooling/cli/agent-cli-go-github",
    "packages/tooling/script/*",
    "packages/sandbox/image/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@moonrepo/cli": "2.5.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/eslint": "9.6.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-istanbul": "5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "18.5.0",
    "eslint": "^10.11.0",
    "gitlab-ci-local": "^4.76.0",
    "jiti": "^2.7.0",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "npm-check-updates": "23.1.0",
    "prettier": "^3.9.9",
    "quicktype": "26.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "syncpack": "15.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "typescript": "6.0.3"
  },
  "scripts": {
    "docs:dev": "npm run dev --workspace @xonovex/documentation-site",
    "docs:build": "npm run build --workspace @xonovex/documentation-site",
    "docs:preview": "npm run preview --workspace @xonovex/documentation-site",
    "docs:generate": "npm run generate --workspace @xonovex/documentation-site",
    "docs:check": "npm run generated:check --workspace @xonovex/documentation-site",
    "deps:check": "npm-check-updates --workspaces --dep prod,dev,optional,packageManager",
    "deps:update": "npm-check-updates --workspaces -u --dep prod,dev,optional,packageManager",
    "nix:shell": "nix --extra-experimental-features 'nix-command flakes' develop",
    "nix:lock": "nix --extra-experimental-features 'nix-command flakes' flake lock",
    "ci:github": "act push -W .github/workflows/ci.yml --input dry_run=true",
    "ci:gitlab": "gitlab-ci-local --file .gitlab/ci.yml --variable DRY_RUN=true",
    "moon": "moon",
    "build": "moon run :build",
    "test": "moon run :test",
    "lint": "moon run :lint",
    "lint:fix": "moon run :lint-fix",
    "fmt": "moon run :format",
    "fmt:check": "moon run :format-check",
    "typecheck": "moon run :typecheck",
    "coverage": "moon run :coverage",
    "dev": "moon run :dev",
    "clean": "moon run :clean",
    "check:all": "moon run :lint :typecheck :coverage",
    "check:fast": "moon run :lint-fix :typecheck --concurrency=4",
    "check:affected": "moon run :lint-fix :typecheck :test :coverage :build :format --affected --concurrency=4",
    "check:hook": "moon run :ci-check --affected --status=staged --concurrency=4",
    "ci": "moon ci",
    "sync:hooks": "moon sync hooks",
    "prepare": "npm run sync:hooks"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
