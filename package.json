{
  "name": "xonovex-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/asset/*",
    "packages/config/*",
    "packages/library/*",
    "packages/runtime/plugin/*",
    "packages/tooling/cli/agent-cli-go",
    "packages/tooling/cli/agent-cli-go-github",
    "packages/tooling/cli/agent-validate-go",
    "packages/tooling/cli/agent-validate-go-github",
    "packages/tooling/cli/agent-audit-go",
    "packages/tooling/cli/agent-audit-go-github",
    "packages/tooling/cli/agent-eval-go",
    "packages/tooling/cli/agent-eval-go-github",
    "packages/tooling/script/*",
    "packages/sandbox/image/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@moonrepo/cli": "2.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "knip": "^6.46.1",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.10.1",
    "quicktype": "^26.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "syncpack": "^15.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "typescript": "6.0.3"
  },
  "scripts": {
    "deps:check": "npm-check-updates --root --workspaces --dep prod,dev,optional,packageManager",
    "deps:update": "npm-check-updates --root --workspaces -u --dep prod,dev,optional,packageManager",
    "nix:shell": "nix --extra-experimental-features 'nix-command flakes' develop",
    "nix:lock": "nix --extra-experimental-features 'nix-command flakes' flake lock",
    "ci:github": "act push -W .github/workflows/ci.yml --input dry_run=true",
    "moon": "moon",
    "build": "moon run :build",
    "test": "moon run :test",
    "lint": "moon run :lint",
    "lint:fix": "moon run :lint-fix",
    "fmt": "moon run :format",
    "fmt:check": "moon run :format-check",
    "typecheck": "moon run :typecheck",
    "coverage": "moon run :coverage",
    "dev": "moon run :dev",
    "clean": "moon run :clean",
    "check:all": "moon run :lint :typecheck :coverage",
    "check:fast": "moon run :lint-fix :typecheck --concurrency=4",
    "check:affected": "moon run :lint-fix :typecheck :test :coverage :build :format --affected --concurrency=4",
    "check:hook": "moon run :ci-check --affected --status=staged --concurrency=4",
    "ci": "moon ci",
    "sync:hooks": "moon sync hooks",
    "prepare": "npm run sync:hooks"
  },
  "packageManager": "npm@11.21.3",
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
