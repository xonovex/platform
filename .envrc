# nix-direnv archives the flake after each evaluation, to make garbage
# collection roots for the flake inputs. The archive copies every tracked file
# of the repository to the store. A dry run of the archive names the same paths
# and copies nothing, so nix-direnv gets the paths that are in the store and
# makes its roots from those.
if declare -F _nix >/dev/null; then
  if [[ $(declare -f use_flake) != *'_nix flake archive'* ]]; then
    log_error 'nix-direnv does not archive through _nix any more: update the guard in .envrc'
    return 1
  fi
  definition=$(declare -f _nix)
  eval "_nix_with_archive${definition#_nix}"
  unset definition
  _nix() {
    local listing path
    if [[ ${1-} != flake || ${2-} != archive ]]; then
      _nix_with_archive "$@"
      return
    fi
    listing=$(_nix_with_archive flake archive --dry-run "${@:3}")
    while [[ $listing =~ /nix/store/[^\"]+ ]]; do
      path=${BASH_REMATCH[0]}
      [[ ! -e $path ]] || printf '"%s"\n' "$path"
      listing=${listing/$path/}
    done
  }
fi
# nix-direnv watches flake.nix and flake.lock, and not the modules.
watch_file nix/*.nix
use flake
